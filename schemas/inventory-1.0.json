{
  "$defs": {
    "Episode": {
      "description": "Episode boundaries and source locations without loaded samples.",
      "properties": {
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "length": {
          "title": "Length",
          "type": "integer"
        },
        "data_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data File"
        },
        "from_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Index"
        },
        "to_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Index"
        },
        "tasks": {
          "items": {
            "type": "string"
          },
          "title": "Tasks",
          "type": "array"
        },
        "video_files": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Video Files",
          "type": "object"
        },
        "video_ranges": {
          "additionalProperties": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Video Ranges",
          "type": "object"
        }
      },
      "required": [
        "index",
        "identifier",
        "length"
      ],
      "title": "Episode",
      "type": "object"
    },
    "Stream": {
      "description": "A logical time-aligned feature exposed by an adapter.",
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "dtype": {
          "title": "Dtype",
          "type": "string"
        },
        "shape": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Shape",
          "type": "array"
        },
        "kind": {
          "default": "scalar",
          "title": "Kind",
          "type": "string"
        },
        "names": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "additionalProperties": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Names"
        },
        "units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        }
      },
      "required": [
        "key",
        "dtype"
      ],
      "title": "Stream",
      "type": "object"
    }
  },
  "description": "Cheap metadata inventory returned by ``physlint inspect``.",
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "source_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Revision"
    },
    "path": {
      "title": "Path",
      "type": "string"
    },
    "adapter": {
      "title": "Adapter",
      "type": "string"
    },
    "format_version": {
      "title": "Format Version",
      "type": "string"
    },
    "profile": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profile"
    },
    "robot_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Robot Type"
    },
    "fps": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fps"
    },
    "total_frames": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Frames"
    },
    "total_messages": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Messages"
    },
    "streams": {
      "items": {
        "$ref": "#/$defs/Stream"
      },
      "title": "Streams",
      "type": "array"
    },
    "episodes": {
      "items": {
        "$ref": "#/$defs/Episode"
      },
      "title": "Episodes",
      "type": "array"
    },
    "capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Capabilities",
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "name",
    "path",
    "adapter",
    "format_version",
    "streams",
    "episodes",
    "capabilities"
  ],
  "title": "DatasetInventory",
  "type": "object"
}
